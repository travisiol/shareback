# ── Sessions (required in production; dev generates its own key in ./data)
# 32+ random characters. Signs the wallet session and reviewer cookies.
SESSION_SECRET=

# ── Manual review (required for /admin; 16+ characters)
ADMIN_SECRET=

# ── Storage (optional). Directory for the SQLite database and private receipt
# files. Defaults to ./data. Must be a persistent disk in production.
SHAREBACK_DATA_DIR=

# ── Network (optional overrides; defaults are in src/config/network.ts)
NEXT_PUBLIC_RPC_URL=
RPC_URL=

# ── Live claims (leave empty until a reward contract is deployed and funded)
# Address of the deployed reward contract on Robinhood Chain.
NEXT_PUBLIC_REWARD_VAULT_ADDRESS=
# Private key of the reward signer the contract trusts. Server only. Never commit it.
REWARD_SIGNER_PRIVATE_KEY=

# ── Optional
NEXT_PUBLIC_CONTACT_EMAIL=
